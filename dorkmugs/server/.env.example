# ─── App ──────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=5000

# Cloudinary credentials may also be loaded from ../../.env
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
CLOUDINARY_STICKER_FOLDER=gostick.gg/stickers
STICKER_PRICE=8.99
CLOUDINARY_CATALOG_CACHE_MS=60000

# Comma-separated list of frontend origins allowed by CORS
# In dev this is the file:// origin or live-server URL
ALLOWED_ORIGINS=http://127.0.0.1:5500,http://localhost:5500

# ─── Database ─────────────────────────────────────────────────────────────────
# SQLite for dev (file path relative to /server)
DATABASE_URL="file:./prisma/dev.db"
# PostgreSQL for production — swap the line above with:
# DATABASE_URL="postgresql://user:pass@host:5432/gostick?schema=public"

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace_with_random_64_char_hex
JWT_REFRESH_SECRET=replace_with_different_random_64_char_hex
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ─── Stripe ───────────────────────────────────────────────────────────────────
# Get from: https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_test_...
# Webhook signing secret from: Stripe Dashboard → Webhooks → your endpoint → Signing secret
STRIPE_WEBHOOK_SECRET=whsec_...
# Where to send customers after payment (append ?session_id={CHECKOUT_SESSION_ID})
STRIPE_SUCCESS_URL=http://localhost:5500/order-success.html
STRIPE_CANCEL_URL=http://localhost:5500/index.html

# ─── Printify ─────────────────────────────────────────────────────────────────
# Get from: https://printify.com/app/account/connections
PRINTIFY_API_KEY=
# Get from: Printify → Shops → copy the numeric ID from the URL
PRINTIFY_SHOP_ID=
PRINTIFY_AUTO_SYNC=true
PRINTIFY_SYNC_INTERVAL_MS=60000
PRINTIFY_SYNC_BATCH_SIZE=50
PRINTIFY_STICKER_BLUEPRINT_ID=803
PRINTIFY_STICKER_PROVIDER_ID=73
PRINTIFY_STICKER_VARIANT_ID=75060
PRINTIFY_STICKER_PRICE_CENTS=899
PRINTIFY_ARTWORK_SCALE=0.9
PUBLIC_STORE_URL=http://localhost:5000

# ─── Email (Nodemailer) ───────────────────────────────────────────────────────
# Use SendGrid, Postmark, or any SMTP provider
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=apikey
SMTP_PASS=your_smtp_password_or_api_key
EMAIL_FROM=GoStick <noreply@gostick.gg>

# ─── Admin seed ───────────────────────────────────────────────────────────────
# Used only when running: npm run db:seed
SEED_ADMIN_EMAIL=admin@gostick.gg
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Admin
